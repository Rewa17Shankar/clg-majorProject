# # Dependencies
# node_modules/

# # Build output
# dist/
# build/

# # Environment variables
# .env
# .env.local
# .env.development.local
# .env.test.local
# .env.production.local

# # Logs
# npm-debug.log*
# yarn-debug.log*
# yarn-error.log*
# pnpm-debug.log*
# lerna-debug.log*

# # Editor files
# .vscode/
# .idea/
# *.swp
# *.swo

# # OS generated files
# .DS_Store
# Thumbs.db



# # .env

# # # Logs
# # logs
# # *.log
# # npm-debug.log*
# # yarn-debug.log*
# # yarn-error.log*
# # pnpm-debug.log*
# # lerna-debug.log*

# # node_modules
# # dist
# # dist-ssr
# # *.local

# # # Editor directories and files
# # .vscode/*
# # !.vscode/extensions.json
# # .idea
# # .DS_Store
# # *.suo
# # *.ntvs*
# # *.njsproj
# # *.sln
# # *.sw?



cat > .gitignore << 'EOF'
# ===========================================
# Node & React Dependencies
# ===========================================
node_modules/
dist/
build/

# ===========================================
# Environment Variables (Do NOT push to GitHub)
# ===========================================
.env
.env.local
.env.production
.env.development
.env.test

# For frontend (Vite / React)
*.local
*.secret

# ===========================================
# Logs
# ===========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===========================================
# OS / Editor Files
# ===========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===========================================
# Temporary files
# ===========================================
*.tmp
*.cache

# ===========================================
# Optional: Ignore uploads if any
# ===========================================
uploads/
EOF
